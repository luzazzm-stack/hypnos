{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "hypnos hook claude SessionStart", "timeout": 20 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "hypnos hook claude UserPromptSubmit", "timeout": 30 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "hypnos hook claude PostToolUse", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "hypnos hook claude Stop", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "hypnos hook claude PreCompact", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "hypnos hook claude SessionEnd", "timeout": 10 } ] }
    ]
  }
}
